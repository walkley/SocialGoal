
@model SocialGoal.Model.Models.Goal

<div class="well span6" style="min-height: 202px;">
    <strong>Invite Users</strong>
    <hr />
    <div id="InviteUserDiv">
        <div class="input-append">
            <input id="searchUser" type="text" class="span7" placeholder="Enter username" />
            <input id="btnInvite" type="button" class="btn btn-primary" value="Invite" onclick="InviteUserToFollow();" />
        </div>
    </div>
    <div id="InviteEmailDiv" style="margin-top: 10px;">
        <div class="input-append">
            <input id="Email" type="text" class="span7" placeholder="Enter email" />
            <input id="btnInviteEmail" type="button" class="btn btn-primary" value="Invite" onclick="InviteUserByEmail();" />
        </div>
    </div>
    <div id="divInviteStatus" style="margin-top: 10px;">
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $("#searchUser").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Goal/SearchUser",
                    type: "GET",
                    dataType: "json",
                    data: { username: request.term, goalId: @Model.GoalId },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.label, value: item.value, id: item.id };
                        }));
                    }
                });
            },
            minLength: 1,
            select: function (event, ui) {
                $("#searchUser").attr("userid", ui.item.id);
            }
        });
    });

    function InviteUserToFollow() {
        var userid = $("#searchUser").attr("userid");
        var url = '/Goal/InviteUser';
        $.post(url, { 'id': @Model.GoalId, 'userId': userid }, function (result) {
            $("#divInviteStatus").html(result);
        });
    }

    function InviteUserByEmail() {
        var email = $("#Email").val();
        var url = '/Goal/InviteEmail';
        $.post(url, { 'Email': email, 'GrouporGoalId': @Model.GoalId }, function (result) {
            $("#divInviteStatus").html("<div class='alert'>" + result + "</div>");
        });
    }
</script>