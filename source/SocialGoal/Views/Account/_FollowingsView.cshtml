@model IEnumerable<SocialGoal.Web.ViewModels.FollowingViewModel>
@foreach (var item in Model)
{
    <table class="table">
        <tr class="span12">
            <td class="span1">
                <a href="@Url.Action("UserProfile", "Account", new { id = item.UserId }, null)" >
                    <img src="@item.ProfilePicUrl" alt="@item.UserName's avatar" class="user-avatar" />
                </a>
            </td>
            <td class="span5">
                @Html.ActionLink(@item.UserName, "UserProfile", "Account", new { id = item.UserId }, null)
            </td>
        </tr>
    </table>

}
