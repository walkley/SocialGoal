@model SocialGoal.Web.ViewModels.UpdateSupportersViewModel

<div class="well">
@if (Model.Users.Count() == 0)
{
    <p class="span5 alert alert-info supporters-message">No Supporters</p>
}
    @foreach (var item in Model.Users)
    {
        <div style="margin:0px;padding:10px;">
         <div style="margin-left:1px;">

                <a href="@Url.Action("UserProfile", "Account", new { id = item.Id }, null)" >
                    <img src="@item.ProfilePicUrl" class="span3" style="margin-right:10px;" />
                </a>
         </div>
         <div style="margin:0px;">
            @Html.ActionLink(@item.UserName, "UserProfile", "Account", new { id = item.Id }, null)
            <div>@item.Email</div>
         </div>
         </div>
               <hr />

            }
</div>
